/* DaGhE TUI Stylesheet - UK English spelling */

Screen {
    background: #1a1b26;
}

#sidebar {
    width: 35;
    border-right: solid $primary;
    background: #16161e;
}

#detail-area {
    padding: 1 2;
}

.section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

.placeholder {
    color: #565f89;
    text-style: italic;
    margin: 1 0;
}

.mode-testing {
    color: #e0af68;
}

.mode-production {
    color: #9ece6a;
}

/* Sidebar Indicator Styling */
.running-marker {
    visibility: hidden;
    color: #e0af68;
    text-style: bold;
}

.running-active .running-marker {
    visibility: visible;
}

/* Optional TCSS Refinement: Blinking effect for the indicator */
.running-active {
    text-style: italic;
    background: $boost;
}

/* Status Panel Styling */
#module-status {
    background: $boost;
    padding: 1 2;
    margin: 1 0;
    border: tall $background;
    height: auto;
}

.status-success {
    color: #9ece6a;
    border: tall #9ece6a;
}

.status-failure {
    color: #f7768e;
    border: tall #f7768e;
}

.status-empty {
    color: #565f89;
    border: tall #565f89;
}

/* Log Panel Styling */
#module-logs {
    background: #16161e;
    color: #a9b1d6;
    padding: 1 2;
    margin: 1 0;
    border: solid #3b4261;
    height: auto;
    min-height: 5;
    max-height: 20;
}

#action-status {
    background: #16161e;
    color: #7aa2f7;
    padding: 0 2;
    margin: 1 0;
    border: inner #3b4261;
    width: 100%;
}

#action-status.busy {
    background: #24283b;
    color: #e0af68;
    border: inner #e0af68;
}

/* Action Error Styling */
.action-error {
    color: #f7768e; /* Fix 4: Red for blocked actions */
    text-style: bold;
}

.live-running {
    color: #e0af68; /* Yellow/Orange */
    text-style: bold;
}

.live-idle {
    color: #565f89; /* Muted Blue/Grey */
    text-style: none;
}
